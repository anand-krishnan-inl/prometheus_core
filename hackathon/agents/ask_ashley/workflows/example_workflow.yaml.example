id: ask-ashley.example_workflow
name: Ask Ashley Example Workflow
version: "1.0.0"
description: Example agent-owned workflow for Ask Ashley. Rename this file to .yaml to publish it.
inputs:
  required:
    - input_data
  optional: []
execution:
  mode: sequential
  max_concurrency: 1
  on_error: fail_fast
steps:
  - id: run_primary_skill
    skill_id: ask
    is_final: true
    params:
      input_data:
        from: input.input_data
outputs:
  final:
    from: step.run_primary_skill.result
metadata:
  requires_approval: false
  estimated_duration_seconds: 30
  owner: ask-ashley
ui:
  category: Ask Ashley
  display_name: Ask Ashley Example Workflow
  summary: Example workflow that invokes the primary Ask Ashley skill.
