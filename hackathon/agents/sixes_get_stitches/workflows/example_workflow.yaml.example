id: read-extract-plot.example_workflow
name: Read Extract Plot Example Workflow
version: "1.0.0"
description: Example agent-owned workflow for Read Extract Plot. Rename this file to .yaml to publish it.
inputs:
  required:
    - input_data
  optional: []
execution:
  mode: sequential
  max_concurrency: 1
  on_error: fail_fast
steps:
  - id: run_primary_skill
    skill_id: read_extract_plot_analysis
    is_final: true
    params:
      input_data:
        from: input.input_data
outputs:
  final:
    from: step.run_primary_skill.result
metadata:
  requires_approval: false
  estimated_duration_seconds: 30
  owner: read-extract-plot
ui:
  category: Read Extract Plot
  display_name: Read Extract Plot Example Workflow
  summary: Example workflow that invokes the primary Read Extract Plot skill.
