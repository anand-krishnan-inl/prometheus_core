# Copy this file to .env and fill in real values.
# .env is gitignored — never commit secrets.

# ── Agent infrastructure ─────────────────────────────────────────────────────

# Shared secret used to authenticate A2A calls between platform components.
# Must match the value set in the platform's .env (platform/.env).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_SECRET=change-me

# Set to 'false' to skip the bearer-token check during local development only.
# AGENT_SECRET_REQUIRED=true

# Optional: directory of agent-owned workflow definitions. Relative paths
# resolve next to agent_card.json. Leave unset to use the default workflows/.
# AGENT_WORKFLOWS=workflows

# URL of the LiteLLM proxy (agent registry + LLM gateway).
# Use the Docker service hostname when running inside Compose.
# When running outside Docker (python agent.py), point at the host-mapped
# LiteLLM port instead, e.g. http://localhost:9977 — otherwise registration
# fails silently because "litellm" does not resolve.
REGISTRY_URL=http://litellm:4000

# Optional Docker external mode. Leave both unset to join the platform's Docker
# network. Set both to expose the agent port and register that host URL.
# `host.docker.internal` is a Docker hostname that lets containers reach the
# host machine. Docker Desktop provides it automatically; on Linux the Makefile
# includes docker-compose.linux.yml in external mode to add the same mapping.
# EXTERNAL_AGENT_HOST=my-host.example.gov
# EXTERNAL_AGENT_PORT=8042

# In external mode, point platform service URLs at addresses reachable from
# inside this container. For services published on the Docker host, use
# host.docker.internal instead of localhost.
# REGISTRY_URL=http://host.docker.internal:9977
# REDIS_URL=redis://host.docker.internal:6379
# JWKS_URL=http://host.docker.internal:8600/.well-known/jwks.json

# LiteLLM master key — must match the platform's LITELLM_MASTER_KEY.
LITELLM_MASTER_KEY=sk-change-me

# Redis connection details — must match the platform's Redis service.
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=change-me

# ── Multi-user identity (RS256) ──────────────────────────────────────────────

# Verify which platform user is calling this agent. Signing is RS256 only —
# there is no shared-secret option, so this agent only ever needs a
# *verification* key; it can never mint a token or impersonate a user.
#
# Pick ONE of the two options below.
#
# Option A — JWKS URL (recommended): fetches and caches the platform's public
# key(s) automatically, including transparent key rotation done through the
# platform's admin UI. Point this at the platform BACKEND, not at another
# agent — every agent serves its own JWKS too, but only the backend's
# reflects an admin-UI-rotated key. Joining the platform's Docker network
# (the default; see EXTERNAL_AGENT_HOST above), the backend resolves by
# container name, same as REGISTRY_URL/REDIS_URL above (external-mode /
# third-party override lives in that same section, not repeated here):
JWKS_URL=http://backend:8000/.well-known/jwks.json
#
# Option B — a static public key the platform operator gives you directly.
# Generate/inspect keys with `prometheus-identity-keygen` (ships in
# prometheus_api, already installed in this agent's base image) or `openssl`.
# Won't observe a key rotated through the admin UI -- ask the operator for
# the new key if verification starts failing after a rotation.
# USER_IDENTITY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
#
# These two must match exactly what the platform operator configured:
# USER_IDENTITY_ISS=prometheus-platform
# USER_IDENTITY_AUD=prometheus-agents
#
# false only for standalone local testing with no platform identity configured.
# USER_IDENTITY_REQUIRED=true

# ── LLM configuration ────────────────────────────────────────────────────────

# Your agent asks for a semantic flavor in code (e.g. `medium`); the selected
# profile maps that flavor to a concrete provider model. You choose the profile
# here and never the model name -- which model backs `medium` is the agent
# author's decision, made in code, and deployment config must not override it.
#
# Installed profiles: registry, inl_hpc, inl_litellm, amsc, anthropic, openai.
# `registry` -- the default when this is unset -- routes inference through the
# platform's LiteLLM proxy at REGISTRY_URL, which is what you want when running
# against the platform. Setting ANTHROPIC_API_KEY alone does NOT change that
# routing; to call Anthropic directly you must also set the profile below.
LLM_CONFIG_PROFILE=registry

# Overrides LLM_CONFIG_PROFILE with your own flavor→model YAML. The path is
# resolved inside the container, so mount the file in docker-compose.yml first.
# LLM_CONFIG_FILE=

# Direct-provider credentials. Only the keys the selected profile references are
# read -- under `registry` the proxy holds them and none of these are needed.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=
# AMSC_I2_API_KEY=       # amsc profile: both inference and its MLflow tracing

# ── Proxy (corporate environments, optional) ─────────────────────────────────

# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,host.docker.internal,registry,redis

# ── DeepLynx storage (optional — if your agent consumes or produces artifacts or reads/writes DeepLynx) ────

# Use either API key/secret OR a JWT token (not both).
# DEEPLYNX_KEY=your-api-key-here
# DEEPLYNX_SECRET=your-api-secret-here
# DEEPLYNX_JWT_TOKEN=your-jwt-token-here
# DEEPLYNX_ORG_ID=123
# DEEPLYNX_PROJECT_ID=456
# DEEPLYNX_DATA_SOURCE_ID=789          # required for creating records
# DEEPLYNX_BASE_URL=https://deeplynx.inl.gov/api/v1

# ── Runtime tuning (optional — every one of these has a working default) ─────

# Leave these commented unless you have a reason. They are listed so you know
# the knobs exist; the defaults live in prometheus_api, which is the single
# source of truth -- docker-compose.yml forwards each one as empty when unset,
# and an empty value means "use the default", so nothing is duplicated here.

# CREDENTIAL_BROKER=env               # env (default) | vault | bespoke
# REGISTRY_MAX_RETRIES=10             # LiteLLM registration attempts at startup
# PROMETHEUS_TASK_STORE=redis         # redis (default) | memory, for local runs
# AGENT_CONTEXT_TTL_SECONDS=          # conversation-context expiry in Valkey
# ARTIFACT_REGISTRY_TTL_SECONDS=      # artifact-reference expiry in Valkey
# TASK_STORE_TTL_SECONDS=             # task-record expiry in Valkey
# USER_WORKER_MAX=32                  # cap on per-user worker processes
# USER_WORKER_IDLE_TTL=300            # seconds before an idle worker is reaped

# Vault (only when CREDENTIAL_BROKER=vault) and Slurm submission are configured
# through their own VAULT_* / SLURM_* variables -- see, in the prometheus_api
# repo, docs/agent/MULTI_USER.md.

# ── Agent-specific variables ─────────────────────────────────────────────────

# Add your own variables here.
# MY_API_KEY=
